# Copy to .env
# Pick ONE provider (free Gemini key: https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: comma-separated backup models used if the main one is overloaded
# GEMINI_FALLBACK_MODELS=

# Or Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
PORT=8000
